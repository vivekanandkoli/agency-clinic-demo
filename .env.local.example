# Copy this file to .env.local and fill in values. Next.js only loads .env.local (not this file).
# From Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Legacy name (optional fallback): NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — Supabase Dashboard → Project Settings → API → Secret keys
SUPABASE_SECRET_KEY=sb_secret_your-secret-key
# Legacy name (optional): SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Database password (Project Settings → Database) — required for one-click "Set up database"
SUPABASE_DB_PASSWORD=your-database-password
# Or full URI: DATABASE_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres

ANTHROPIC_API_KEY=sk-ant-api03-...

# Admin login — comma-separated emails allowed to access /admin
ADMIN_EMAILS=admin@agency-clinic.com
# Optional password when setup creates the first admin user (default: SoundDental123!)
# ADMIN_INITIAL_PASSWORD=YourSecurePassword
